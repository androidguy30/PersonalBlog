---
import Layout from "../layouts/Base.astro"
import "../styles/portfolio.css";
import { getCollection } from "astro:content";

/**
 * Load all work items from src/content/work
 */
const work = await getCollection("work");

/**
 * Filter only featured items (used by cards + timeline)
 */
const featured = work
  .filter((w) => w.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

/**
 * Helper to render separators without encoding issues.
 * We intentionally avoid using a literal "·" character.
 */
const sep = " &middot; ";
---

<Layout title="Portfolio" description="Selected work across embedded finance, platforms, SDKs, and high-scale consumer apps.">
  <section class="portfolioSection" style="margin-top: 2rem;">
    <h2>Timeline</h2>

    <!-- Timeline view -->
    <div class="view viewTimeline" style="margin-top: 1rem;">
      <ol class="timeline">
        {featured.map((item) => (
          <li class="tItem">
            <div class="tDot" aria-hidden="true"></div>

            <article class="tCard">
              <div class="tHead">
                <div>
                  <h3 style="margin:0;">{item.data.company}</h3>

                  {/* Avoid literal "·" by injecting HTML separator */}
                  <div
                    style="opacity:.8; margin-top:.25rem;"
                    set:html={`${item.data.role}${sep}${item.data.domain}${item.data.period ? `${sep}${item.data.period}` : ""}`}
                  />
                </div>

                {item.data.logo && (
                  <img
                    src={item.data.logo}
                    alt={`${item.data.company} logo`}
                    class="tLogo"
                    loading="lazy"
                  />
                )}
              </div>

              <p style="margin-top:.75rem;">{item.data.blurb}</p>

              {item.data.impact?.length ? (
                <div class="impact">
                  {item.data.impact.slice(0, 4).map((x) => (
                    <div style="margin-top: 0.5rem;"><b>Impact:</b> {x}</div>
                  ))}
                </div>
              ) : null}

              {item.data.highlights?.length ? (
                <ul style="margin:.5rem 0 0 1.1rem;">
                  {item.data.highlights.slice(0, 4).map((h) => <li>{h}</li>)}
                </ul>
              ) : null}

              {item.data.artifacts?.length ? (
                <div style="margin-top: .9rem;">
                  {item.data.artifacts.map((a) => (
                    <a href={a.url} target="_blank" rel="noreferrer" style="display: inline-block; margin-right: 1rem; margin-bottom: 0.5rem;">
                      {a.kind === "video" ? "🎥 " : a.kind === "app" ? "📱 " : "🔗 "}
                      {a.label}
                    </a>
                  ))}
                </div>
              ) : null}

              {item.data.tech?.length ? (
                <div class="chips" style="margin-top: .9rem;">
                  {item.data.tech.slice(0, 8).map((t) => <span class="chip">{t}</span>)}
                </div>
              ) : null}

            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
